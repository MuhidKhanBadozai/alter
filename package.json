{
  "name": "alter",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently \"npm run dev\" \"node electron-dev.cjs\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.alter.app",
    "productName": "Alter",
    "publish": [
      {
        "provider": "github",
        "owner": "MuhidKhanBadozai",
        "repo": "alter"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "main.cjs",
      "preload.cjs"
    ],
    "asarUnpack": [
      "node_modules/youtube-dl-exec/bin/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/alter.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/alter.ico"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "play-dl": "^1.9.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-player": "^3.4.0",
    "vite": "^6.2.3",
    "youtube-dl-exec": "^3.1.9",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.3",
    "cross-env": "^7.0.3",
    "electron": "^36.9.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wait-on": "^8.0.5"
  }
}
